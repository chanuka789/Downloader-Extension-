{
  "manifest_version": 3,
  "name": "MediaHarbor – Image & Video Downloader",
  "short_name": "MediaHarbor",
  "version": "1.1.0",
  "description": "Find and save images and videos in the best available quality from Instagram, Facebook, X, TikTok and almost any website.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MediaHarbor – save images & videos",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "webRequest",
    "contextMenus",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/extract.js", "content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared/rules.js", "shared/extract.js", "content/detector.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["shared/extract.js", "content/instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Open MediaHarbor"
    }
  }
}
